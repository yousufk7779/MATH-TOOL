# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# scratch scripts
scratch/

# generated native folders
/ios
/android

# --- EAS upload only (not needed by the build) ---
.claude/
docs/

# --- EAS upload only: root-level files/folders not used by the app or the build ---
# Version history (EAS builds from the uploaded files, not from git)
/.git/
# Throwaway root scripts, logs and dumps (root level only; nothing under client/ is affected)
/*.py
/*.txt
/*.log
/*.jpg
/*.svg
/*.xml
/*.html
/*.ps1
/exercises_content.json
/full_images.json
/extracted_targets.json
/p_map.json
/search_results.json
# Unrelated tooling and source documents
/scripts/
/source_docs/
/temp_docx/
/.local/
